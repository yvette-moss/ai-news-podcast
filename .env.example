# Telegram bot credentials (create a bot via @BotFather to get the token)
TELEGRAM_BOT_TOKEN=
# The chat ID that should receive the podcast (your own user ID, a group, or a channel)
TELEGRAM_CHAT_ID=

# Which LLM writes the script: "groq" (default, free & fast) or "gemini"
LLM_PROVIDER=groq

# Groq Cloud API key (https://console.groq.com/keys) - required when LLM_PROVIDER=groq
GROQ_API_KEY=
# Google AI Studio API key (https://aistudio.google.com/apikey) - optional fallback,
# only required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Caps how many articles get bundled into the single script-writing prompt
# (up to 1-2 per RSS feed, for source diversity). The whole pipeline makes
# exactly one LLM request per run, so this just keeps the prompt focused.
MAX_ARTICLES=6

# "daily" or "weekly" - controls both the news lookback window and the
# default GitHub Actions cron schedule generated by --setup
PODCAST_CADENCE=daily

# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
EDGE_TTS_VOICE=en-US-ChristopherNeural
TARGET_BITRATE_KBPS=48
# Only relevant as a floor between retries -- the free tier is commonly 5/min.
GEMINI_REQUESTS_PER_MINUTE=5
